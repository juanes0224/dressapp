# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

URL_BASE_DATOS=sqlite:///./dressapp.db

DIRECTORIO_SUBIDAS=uploads
TAMANO_MAXIMO_IMAGEN_MB=5

# Etapa 8 (clasificacion por foto), desactivado por defecto
CLASIFICADOR_ACTIVO=false

# Etapa 10 (explicaciones redactadas por LLM), opcional
CLAVE_API_LLM=

CLIMA_TIMEOUT_SEGUNDOS=3.0
CLIMA_CACHE_MINUTOS=30
